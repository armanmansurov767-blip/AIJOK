# Скопируйте в .env и заполните. Файл .env не попадает в git.

# --- Чтение документов ИИ (Anthropic API) ---
# Ключ: https://platform.claude.com -> API Keys. Без ключа документы читаются правилами
# и каждое заявление уходит сотруднику на проверку.
ANTHROPIC_API_KEY=
# auto (включить, если есть ключ) | on | off
DOCAGENT_AI=auto
DOCAGENT_MODEL=claude-opus-5-5
# Глубина рассуждений модели: low | medium | high
DOCAGENT_EFFORT=medium

# --- Организация ---
DOCAGENT_ORG_NAME=Учебная часть
# Адрес, по которому студенты открывают сайт (для ссылок в письмах)
DOCAGENT_PUBLIC_URL=http://localhost:8000

# --- Почта (SMTP). Без неё ответ виден студенту только на странице статуса ---
DOCAGENT_SMTP_HOST=
DOCAGENT_SMTP_PORT=587
DOCAGENT_SMTP_USER=
DOCAGENT_SMTP_PASSWORD=
DOCAGENT_SMTP_FROM=
# 1 для SMTP через SSL (порт 465), иначе STARTTLS
DOCAGENT_SMTP_SSL=0

# --- Сервер ---
DOCAGENT_DATA_DIR=./data
# 1, когда сайт работает по HTTPS
DOCAGENT_SECURE_COOKIES=0
DOCAGENT_SESSION_HOURS=12
DOCAGENT_WORKERS=2
DOCAGENT_MAX_FILES=5
DOCAGENT_MAX_FILE_MB=15
